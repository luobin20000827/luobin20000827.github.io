---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
---
<BaseLayout title={`${title} · 博客`} description={description}>
  <article class="prose">
    <header style="margin-bottom:1.5rem">
      <h1 class="title-link" style="margin:0 0 .5rem">{title}</h1>
      <p class="muted small" style="margin:.3rem 0">
        <FormattedDate date={pubDate} />
        {updatedDate && <span> · 更新于 <FormattedDate date={updatedDate} /></span>}
      </p>
      {
        tags.length > 0 && (
          <span class="tags">
            {tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </span>
        )
      }
    </header>
    <slot />
  </article>
  <p style="margin-top:3rem">
    <a href="/blog">← 返回文章列表</a>
  </p>
</BaseLayout>
